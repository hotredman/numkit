{
  "name": "nk-play",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "NumKit Play — reactive gallery for @play scripts (Svelte 5, no React)",
  "scripts": {
    "dev": "node scripts/sync-wasm.mjs && vite",
    "build": "node scripts/sync-wasm.mjs && node scripts/build-gallery.mjs && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "gallery": "node scripts/build-gallery.mjs",
    "smoke:play": "node ../ide/scripts/play-bindings.smoke.mjs",
    "sync:wasm": "node scripts/sync-wasm.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^22.20.2",
    "svelte": "^5.0.0",
    "svelte-check": "^4.7.6",
    "typescript": "~5.7",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@lezer/highlight": "^1.2.3"
  }
}
