{
  "name": "numkit_ide",
  "version": "2.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:core": "playwright test tests/e2e/core",
    "test:2d": "playwright test tests/e2e/2d",
    "test:3d": "playwright test tests/e2e/3d",
    "test:figures": "playwright test tests/e2e/figures",
    "test:regressions": "playwright test tests/e2e/regressions",
    "test:examples": "playwright test tests/e2e/examples"
  },
  "build": {
    "appId": "com.numkit.ide",
    "productName": "numkit_ide",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "dist/**/*"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "numkit_ide.exe"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  }
}
