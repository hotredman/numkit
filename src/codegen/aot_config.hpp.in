#pragma once
// Generated by CMake (src/codegen/CMakeLists.txt) from aot_config.hpp.in.
// Captures, at configure time, the external C++ compiler the AOT harness
// (aot.cpp) shells out to. Paths use FORWARD slashes (valid in a C++
// string literal); aot.cpp converts to native separators when it builds
// the command. Do not edit — re-run cmake to regenerate.

// 1 when an external compiler was located at configure time, else 0
// (the harness then reports Unavailable and the e2e gate is skipped).
#define NUMKIT_CODEGEN_AOT_AVAILABLE @NUMKIT_CODEGEN_AOT_AVAILABLE@

// 1 when that compiler is MSVC (needs a vcvars environment), else 0.
#define NUMKIT_CODEGEN_AOT_IS_MSVC @NUMKIT_CODEGEN_AOT_IS_MSVC@

// MSVC: absolute path to vcvars64.bat (sets INCLUDE/LIB/PATH). Empty for
// a non-MSVC compiler.
#define NUMKIT_CODEGEN_AOT_VCVARS "@NUMKIT_CODEGEN_AOT_VCVARS@"

// The C++ compiler command (full path). Used directly for a non-MSVC
// compiler; for MSVC the harness invokes `cl` from the vcvars shell.
#define NUMKIT_CODEGEN_AOT_CXX "@NUMKIT_CODEGEN_AOT_CXX@"
