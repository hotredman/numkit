/**
@mainpage NumKit — High-Performance C++ Numerical Computing Runtime

\htmlonly
<h2 class="section-title">Fundamentals</h2>
<div class="topics-grid">

  <a class="topic-card" href="group__group__elmat.html">
    <div class="card-icon">🔢</div>
    <div class="card-body">
      <div class="card-title">elmat — Elementary Matrices &amp; Arrays</div>
      <div class="card-desc">Constructors (<code>zeros</code>, <code>ones</code>, <code>eye</code>, <code>rand</code>), shape transformations (<code>reshape</code>, <code>permute</code>, <code>repmat</code>, <code>cat</code>), and test matrices.</div>
    </div>
  </a>

  <a class="topic-card" href="group__group__elfun.html">
    <div class="card-icon">📐</div>
    <div class="card-body">
      <div class="card-title">elfun — Elementary Math Functions</div>
      <div class="card-desc">Trigonometric (<code>sin</code>, <code>cos</code>, <code>atan2</code>), exponential (<code>exp</code>, <code>log</code>, <code>sqrt</code>), complex (<code>abs</code>, <code>angle</code>), and rounding (<code>floor</code>, <code>ceil</code>, <code>mod</code>).</div>
    </div>
  </a>

  <a class="topic-card" href="group__group__matfun.html">
    <div class="card-icon">🧮</div>
    <div class="card-body">
      <div class="card-title">matfun / linalg — Matrix Algebra &amp; Solvers</div>
      <div class="card-desc">Linear equation solvers (<code>linsolve</code>, <code>mldivide</code>, <code>inv</code>), decompositions (<code>lu</code>, <code>qr</code>, <code>chol</code>, <code>svd</code>, <code>eig</code>), and matrix functions.</div>
    </div>
  </a>

  <a class="topic-card" href="group__group__datafun.html">
    <div class="card-icon">📈</div>
    <div class="card-body">
      <div class="card-title">datafun — Data Analysis &amp; Fourier Transforms</div>
      <div class="card-desc">Summary reductions (<code>sum</code>, <code>mean</code>, <code>std</code>), cumulative diffs (<code>cumsum</code>, <code>diff</code>), 1D/2D FFTs (<code>fft</code>, <code>ifft</code>), and <code>accumarray</code>.</div>
    </div>
  </a>

  <a class="topic-card" href="group__group__specfun.html">
    <div class="card-icon">🔬</div>
    <div class="card-body">
      <div class="card-title">specfun — Specialized Math Functions</div>
      <div class="card-desc">Bessel functions (<code>besselj</code>, <code>bessely</code>), Airy functions, Gamma, Beta, Error functions (<code>erf</code>, <code>erfc</code>), and number theory.</div>
    </div>
  </a>

  <a class="topic-card" href="group__group__polyfun.html">
    <div class="card-icon">📊</div>
    <div class="card-body">
      <div class="card-title">polyfun — Polynomials &amp; Interpolation</div>
      <div class="card-desc">Polynomial operations (<code>polyfit</code>, <code>polyval</code>, <code>roots</code>), 1D/2D/3D interpolation (<code>interp1</code>, <code>griddata</code>), and splines (<code>spline</code>, <code>pchip</code>).</div>
    </div>
  </a>

  <a class="topic-card" href="group__group__strfun.html">
    <div class="card-icon">📝</div>
    <div class="card-body">
      <div class="card-title">strfun — Strings &amp; Text Manipulation</div>
      <div class="card-desc">String composition (<code>sprintf</code>, <code>compose</code>, <code>strjoin</code>), search &amp; regex (<code>strcmp</code>, <code>strfind</code>, <code>regexp</code>), and numerical conversions.</div>
    </div>
  </a>

  <a class="topic-card" href="group__group__datatypes.html">
    <div class="card-icon">📦</div>
    <div class="card-body">
      <div class="card-title">datatypes — Data Types, Structs &amp; Cells</div>
      <div class="card-desc">Structure arrays (<code>struct</code>, <code>fieldnames</code>), Cell arrays (<code>cell</code>, <code>cellfun</code>, <code>deal</code>), type casting, and predicates.</div>
    </div>
  </a>

  <a class="topic-card" href="group__group__timefun.html">
    <div class="card-icon">⏱️</div>
    <div class="card-body">
      <div class="card-title">timefun — Time &amp; Date Functions</div>
      <div class="card-desc">Wall-clock timers (<code>tic</code>, <code>toc</code>), date arithmetic (<code>now</code>, <code>datestr</code>, <code>datevec</code>), and execution delays.</div>
    </div>
  </a>

  <a class="topic-card" href="group__group__iofun.html">
    <div class="card-icon">💾</div>
    <div class="card-body">
      <div class="card-title">iofun &amp; general — Workspace &amp; File I/O</div>
      <div class="card-desc">Workspace persistence (<code>save</code>, <code>load</code>, <code>who</code>, <code>clear</code>), text parsing (<code>textscan</code>, <code>csvread</code>), and file streams.</div>
    </div>
  </a>

</div>

<h2 class="section-title">Toolboxes</h2>
<div class="topics-grid">

  <a class="topic-card" href="group__group__signal.html">
    <div class="card-icon">📡</div>
    <div class="card-body">
      <div class="card-title">Signal Processing Toolbox (signal)</div>
      <div class="card-desc">IIR/FIR filter design (<code>butter</code>, <code>fir1</code>), filter implementation (<code>filtfilt</code>, <code>sosfilt</code>), spectral analysis (<code>pwelch</code>, <code>spectrogram</code>), and windows.</div>
    </div>
  </a>

  <a class="topic-card" href="group__group__stats.html">
    <div class="card-icon">📊</div>
    <div class="card-body">
      <div class="card-title">Statistics and Machine Learning (stats)</div>
      <div class="card-desc">20+ Probability distributions (<code>normpdf</code>, <code>tinv</code>), hypothesis tests (<code>ttest</code>, <code>anova1</code>), regression (<code>regress</code>, <code>fitlm</code>, <code>lasso</code>), and <code>pca</code>.</div>
    </div>
  </a>

  <a class="topic-card" href="group__group__image.html">
    <div class="card-icon">🖼️</div>
    <div class="card-body">
      <div class="card-title">Image Processing Toolbox (image)</div>
      <div class="card-desc">Color space transforms (<code>rgb2gray</code>, <code>rgb2hsv</code>), morphology (<code>imerode</code>, <code>imreconstruct</code>, <code>bwlabel</code>), spatial filtering, and quality metrics (<code>psnr</code>, <code>ssim</code>).</div>
    </div>
  </a>

  <a class="topic-card" href="group__group__control.html">
    <div class="card-icon">⚙️</div>
    <div class="card-body">
      <div class="card-title">Control System Toolbox (control)</div>
      <div class="card-desc">LTI model conversions (<code>tf2ss</code>, <code>ss2tf</code>, <code>zp2tf</code>), frequency response (<code>bode</code>, <code>nyquist</code>), time response (<code>step</code>, <code>impulse</code>), and stability metrics.</div>
    </div>
  </a>

  <a class="topic-card" href="group__group__optim.html">
    <div class="card-icon">🎯</div>
    <div class="card-body">
      <div class="card-title">Optimization Toolbox (optim)</div>
      <div class="card-desc">Unconstrained &amp; bound optimization (<code>fminunc</code>, <code>fminbnd</code>), nonlinear equations (<code>fzero</code>, <code>fsolve</code>), and curve fitting (<code>lsqcurvefit</code>, <code>lsqnonlin</code>).</div>
    </div>
  </a>

  <a class="topic-card" href="group__group__wavelet.html">
    <div class="card-icon">🌊</div>
    <div class="card-body">
      <div class="card-title">Wavelet Toolbox (wavelet)</div>
      <div class="card-desc">1D/2D Discrete Wavelet Transforms (<code>dwt</code>, <code>wavedec2</code>), Stationary Wavelets (<code>swt</code>), filter banks (<code>wfilters</code>), and wavelet denoising (<code>wdenoise</code>).</div>
    </div>
  </a>

  <a class="topic-card" href="group__group__comm.html">
    <div class="card-icon">📶</div>
    <div class="card-body">
      <div class="card-title">Communications Toolbox (comm)</div>
      <div class="card-desc">Digital modulation (<code>pskmod</code>, <code>qammod</code>, <code>fskmod</code>, <code>ofdmmod</code>), channel models (<code>awgn</code>, <code>rayleighchan</code>), error control coding, and scrambling.</div>
    </div>
  </a>

  <a class="topic-card" href="group__group__audio.html">
    <div class="card-icon">🎵</div>
    <div class="card-body">
      <div class="card-title">Audio Toolbox (audio)</div>
      <div class="card-desc">Pitch estimation (<code>pitch</code>, <code>harmonicRatio</code>), spectral shape descriptors (<code>spectralCentroid</code>, <code>spectralFlux</code>), and representations (<code>mfcc</code>, <code>melSpectrogram</code>).</div>
    </div>
  </a>

  <a class="topic-card" href="group__group__ode.html">
    <div class="card-icon">🔄</div>
    <div class="card-body">
      <div class="card-title">Differential Equations (ode)</div>
      <div class="card-desc">Explicit &amp; implicit Runge-Kutta numerical ODE integrators (<code>ode45</code>, <code>ode23</code>, <code>ode113</code>, <code>ode15s</code>, <code>ode23s</code>) and integration options (<code>odeset</code>).</div>
    </div>
  </a>

  <a class="topic-card" href="group__group__graphics.html">
    <div class="card-icon">📊</div>
    <div class="card-body">
      <div class="card-title">2D &amp; 3D Scientific Graphics (graphics)</div>
      <div class="card-desc">Interactive figures, line plots (<code>plot</code>), surface meshes (<code>surf</code>, <code>mesh</code>), scatter charts, histograms, colormaps, and plot styling.</div>
    </div>
  </a>

</div>

<hr/>

<h2 class="section-title">Quick Code Example</h2>
\endhtmlonly

```cpp
#include <numkit/bundle/standard_library.hpp>
#include <numkit/builtin/builtin.hpp>
#include <numkit/signal/signal.hpp>
#include <numkit/linalg/linalg.hpp>
#include <iostream>

using namespace numkit;

int main() {
    // 1. Pure C++ Public API with SIMD acceleration
    Value t = builtin::linspace(0.0, 1.0, 1000);
    Value sig = builtin::sin(2.0 * 3.141592653589793 * 50.0 * t);
    
    // 2. DSP Signal Processing
    Value filtered = signal::filter(signal::fir1(16, 0.2), Value::scalar(1.0), sig);
    
    // 3. Embedded Scripting Engine
    auto engine = makeStandardEngine();
    engine->eval("x = [1, 2, 3; 4, 5, 6];");
    Value res = engine->eval("y = sum(x, 1) * 2;");
    std::cout << "Result: " << res.toString() << std::endl;
    return 0;
}
```

