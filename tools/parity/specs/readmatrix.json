{
  "name": "readmatrix",
  "namespace": "core",
  "setup": "fname = [tempname, '.csv']; fid = fopen(fname, 'w'); fprintf(fid, '1,2,3\\n4,5,6\\n7,8,9\\n'); fclose(fid);",
  "expr": "y = readmatrix(fname);",
  "iters": 100,
  "tol": 1e-09,
  "comment": "Sig: M = readmatrix(F). 100 iters.",
  "out_var": "y"
}
