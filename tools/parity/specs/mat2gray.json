{
  "name": "mat2gray",
  "namespace": "image",
  "setup": "I = double([1 2 3; 4 5 6; 7 8 9]);",
  "expr": "y = mat2gray(I);",
  "iters": 8,
  "tol": 1e-12,
  "out_var": "y",
  "comment": "Sig + small deterministic input. Auto-generated for parity sweep.",
  "bench_setup": "A = reshape(mod((1:N*N)*7919,256)/255, N, N);",
  "bench_expr": "rb = mat2gray(A);",
  "bench_sizes": [
    100,
    1000
  ],
  "bench_note": "grayscale double N×N (100×100 / 1000×1000)"
}
