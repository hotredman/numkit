{
  "name": "conv2",
  "namespace": "core",
  "setup": "[ii, jj] = meshgrid(1:128, 1:128); A = sin(0.05*ii)+cos(0.07*jj); B = ones(7,7)/49;",
  "expr": "C = conv2(A, B, 'same');",
  "iters": 100,
  "tol": 1e-12,
  "out_var": "C",
  "comment": "128x128 image, 7x7 averaging kernel, 'same' shape. 100 iters."
}
