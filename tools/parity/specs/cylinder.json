{
  "name": "cylinder",
  "namespace": "core",
  "setup": "R = sin((0:200) * pi / 200) + 0.5;",
  "expr": "[X, Y, Z] = cylinder(R, 50);",
  "iters": 200,
  "tol": 1e-9,
  "fingerprint": ["sum(X(:))", "sum(Y(:))", "sum(Z(:))", "X(1,1)"],
  "out_var": "Z",
  "comment": "201-point sin-shaped profile, 50 angular samples. 200 iters."
}
