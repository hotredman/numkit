{
  "name": "abs",
  "namespace": "builtin",
  "setup": "x = [-3 -1.5 0 2.5 -4];",
  "expr": "y = abs(x); s = sum(y(:)); y1 = y(1); y4 = y(4);",
  "iters": 20,
  "tol": 1e-12,
  "fingerprint": [
    "s",
    "y1",
    "y4"
  ],
  "bench_setup": "xb = (mod((1:N)*7919,2000)-1000)*0.01;",
  "bench_expr": "rb = abs(xb);",
  "comment": "abs(x) elementwise magnitude. Correctness on a tiny signed vector; benched (SIMD build) at N=1e3/1e6."
}
