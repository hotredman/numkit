{
  "name": "realsqrt",
  "namespace": "core",
  "setup": "x = linspace(0, 1000, 1000000);",
  "expr": "y = realsqrt(x);",
  "iters": 20,
  "tol": 1e-10,
  "out_var": "y",
  "comment": "Sig: Y = realsqrt(X). 1M-pt on [0, 1000]. 20 iters. Element-wise SAVE.",
  "bench_setup": "xb = mod((1:N)*7919,1000)*0.001 + 0.001;",
  "bench_expr": "rb=realsqrt(xb);"
}
