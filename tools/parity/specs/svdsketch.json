{
  "name": "svdsketch",
  "namespace": "builtin",
  "setup": "A = [1 2 3; 4 5 6; 7 8 10];",
  "expr": "[U, S, V] = svdsketch(A, 1e-3); err = max(max(abs(U*S*V' - A)));",
  "iters": 5,
  "tol": 1e-2,
  "fingerprint": [
    "S(1,1)", "err"
  ],
  "comment": "Randomized Gaussian sketch SVD (Halko-Martinsson-Tropp algorithm)."
}
