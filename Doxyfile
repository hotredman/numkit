# Doxyfile for numkit
#
# Generates API documentation for the public headers of toolboxes/*/include/.
# HTML output renders LaTeX formulas via MathJax (no toolchain needed for
# HTML). PDF output requires pdflatex (MiKTeX on Windows, TeX Live on
# Unix); set GENERATE_LATEX = NO to skip if pdflatex is not installed.
#
# Build (after `winget install DimitriVanHeesch.Doxygen` on Windows):
#   doxygen Doxyfile
#   → build/docs/html/index.html
#   → build/docs/latex/refman.pdf  (when GENERATE_LATEX = YES)
#
# Via CMake: `cmake --build <preset> --target docs` (see cmake/Doxygen.cmake).

# ── Project ──────────────────────────────────────────────────────────
PROJECT_NAME           = "numkit"
PROJECT_NUMBER         = "1.0.0"
PROJECT_BRIEF          = "C++ MATLAB-compatible runtime — public C++ API"
PROJECT_LOGO           = brand/numkit-logo-light.svg
OUTPUT_DIRECTORY       = build/docs
OUTPUT_LANGUAGE        = English

# ── Input ────────────────────────────────────────────────────────────
# Only the public include trees of each lib. Implementation .cpp files
# under toolboxes/*/src are excluded (they're not user-facing API).
INPUT                  = doxygen/doxygen_mainpage.dox \
                         doxygen/groups.dox             \
                         src/value/include              \
                         src/core/include               \
                         src/ops/include                \
                         src/builtin/include            \
                         src/runtime/include            \
                         src/bundle/include             \
                         src/graphics/include           \
                         src/figure/include             \
                         src/fs/include                 \
                         src/toolboxes/audio/include    \
                         src/toolboxes/comm/include     \
                         src/toolboxes/control/include  \
                         src/toolboxes/image/include    \
                         src/toolboxes/io/include       \
                         src/toolboxes/linalg/include   \
                         src/toolboxes/ode/include      \
                         src/toolboxes/optim/include    \
                         src/toolboxes/signal/include   \
                         src/toolboxes/stats/include    \
                         src/toolboxes/wavelet/include
FILE_PATTERNS          = *.hpp *.h *.dox
RECURSIVE              = YES
EXCLUDE                = build build-* .claude
# Drop:
#   - library.hpp     — engine-registry hub (just install(Engine&)),
#                       duplicates the sub-namespace listing in the tree
#   - matlab_mt19937  — internal RNG, not part of the user-facing API
EXCLUDE_PATTERNS       = */_deps/*                      \
                         */tests/*                      \
                         */backends/*                   \
                         */library.hpp                  \
                         */matlab_mt19937.hpp
INPUT_ENCODING         = UTF-8

# ── Build options ────────────────────────────────────────────────────
EXTRACT_ALL            = NO        # only entities with /// comments
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
EXTRACT_LOCAL_CLASSES  = NO
EXTRACT_ANON_NSPACES   = NO
HIDE_UNDOC_MEMBERS     = NO        # show undocumented as "(no description)"
HIDE_UNDOC_CLASSES     = NO
INLINE_INHERITED_MEMB  = YES
JAVADOC_AUTOBRIEF      = YES       # first /// line becomes @brief
QT_AUTOBRIEF           = NO
MULTILINE_CPP_IS_BRIEF = NO
INHERIT_DOCS           = YES
TAB_SIZE               = 4
OPTIMIZE_OUTPUT_FOR_C  = NO

# Treat doc-comment blocks that look like markdown as such.
MARKDOWN_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 5

# Pull macro definitions for things that affect API visibility.
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = "NUMKIT_API="                                   \
                         "DOXYGEN_RUNNING=1"

# C++ language tuning.
BUILTIN_STL_SUPPORT    = YES
CPP_CLI_SUPPORT        = NO
SIP_SUPPORT            = NO
DISTRIBUTE_GROUP_DOC   = NO
GROUP_NESTED_COMPOUNDS = NO
SUBGROUPING            = YES

# ── Warnings & diagnostics ───────────────────────────────────────────
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES       # surface remaining doc gaps
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES       # missing @param tags
WARN_AS_ERROR          = NO
WARN_FORMAT            = "$file:$line: $text"
WARN_LOGFILE           = build/docs/doxygen-warnings.log

# ── Source browsing ──────────────────────────────────────────────────
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = YES
REFERENCED_BY_RELATION = NO
REFERENCES_RELATION    = NO
REFERENCES_LINK_SOURCE = YES
VERBATIM_HEADERS       = YES

# ── HTML output ──────────────────────────────────────────────────────
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_HEADER            = doxygen/theme/header.html
HTML_COLORSTYLE        = LIGHT
HTML_EXTRA_STYLESHEET  = doxygen/theme/doxygen-awesome.css \
                         doxygen/theme/custom.css
HTML_EXTRA_FILES       = doxygen/theme/doxygen-awesome-darkmode-toggle.js \
                         doxygen/theme/doxygen-awesome-fragment-copy-button.js \
                         doxygen/theme/doxygen-awesome-paragraph-link.js \
                         doxygen/theme/doxygen-awesome-interactive-toc.js
HTML_DYNAMIC_MENUS     = YES
HTML_DYNAMIC_SECTIONS  = YES
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO

# Search bar (client-side JS, no server needed).
SEARCHENGINE           = YES
SERVER_BASED_SEARCH    = NO

# ── Math rendering: MathJax for HTML ─────────────────────────────────
# Renders @f$...@f$ formulas client-side in the browser. Requires no
# extra installation — MathJax loads from CDN by default.
#
# NB: Doxygen 1.17 appends `es5/<format>.js` itself, so MATHJAX_RELPATH
# must end at `mathjax@3/` (NOT `mathjax@3/es5/`) — otherwise the URL
# becomes `.../es5/es5/tex-chtml.js` (404).
USE_MATHJAX            = YES
MATHJAX_VERSION        = MathJax_3
MATHJAX_FORMAT         = HTML-CSS
MATHJAX_RELPATH        = https://cdn.jsdelivr.net/npm/mathjax@3/

# ── LaTeX / PDF output ───────────────────────────────────────────────
# Builds a reference PDF via pdflatex. Requires MiKTeX (Windows) or
# TeX Live (Unix). Disable if no LaTeX toolchain.
GENERATE_LATEX         = YES
LATEX_OUTPUT           = latex
LATEX_CMD_NAME         = pdflatex
MAKEINDEX_CMD_NAME     = makeindex
COMPACT_LATEX          = NO
PAPER_TYPE             = a4
EXTRA_PACKAGES         = amsmath amssymb
LATEX_HEADER           =
LATEX_FOOTER           =
LATEX_EXTRA_FILES      =
PDF_HYPERLINKS         = YES
USE_PDFLATEX           = YES
LATEX_BATCHMODE        = YES
LATEX_HIDE_INDICES     = NO
LATEX_BIB_STYLE        = plain

# ── Other output formats (disabled) ──────────────────────────────────
GENERATE_MAN           = NO
GENERATE_RTF           = NO
GENERATE_XML           = NO
GENERATE_DOCBOOK       = NO
GENERATE_AUTOGEN_DEF   = NO
GENERATE_PERLMOD       = NO

# ── Diagrams (requires Graphviz / dot) ───────────────────────────────
# If `dot` is on PATH, Doxygen will draw class / collaboration /
# include-graphs. Without it, only text-based graphs appear.
HAVE_DOT               = NO        # set YES + DOT_PATH if Graphviz installed
DOT_NUM_THREADS        = 0
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
GROUP_GRAPHS           = YES
UML_LOOK               = NO
TEMPLATE_RELATIONS     = NO
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = NO
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
GRAPHICAL_HIERARCHY    = YES
DIRECTORY_GRAPH        = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
DOT_GRAPH_MAX_NODES    = 60
MAX_DOT_GRAPH_DEPTH    = 0
GENERATE_LEGEND        = YES
DOT_CLEANUP            = YES
