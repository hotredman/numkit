# ── Build directories ─────────────────────────────────
# All cmake outputs live under /build/<preset>/. Old build-<preset>/
# layout from before the consolidation is also covered by build*/.
/build/
build*/
!engine-build.sh
!engine-build.bat
!desktop-build.bat
.qtcreator

# ── Compiled artefacts ────────────────────────────────
*.d
*.o
*.obj
*.slo
*.lo
*.gch
*.pch
*.ilk
*.pdb
*.so
*.dylib
*.dll
*.mod
*.smod
*.la
*.lai
*.a
*.lib
*.exe
*.out
*.app
*.dwo

# ── Benchmark outputs (produced by benchmarks/bench_simd.{bat,sh}) ─
benchmarks/baseline.json
benchmarks/simd.json

# ── JS / Node ─────────────────────────────────────────
node_modules/
.vite/
ide/dist/

# WASM artefacts copied into the IDE public tree by build/dev scripts —
# regenerated from build-browser/, never committed.
ide/public/numkit_ide.js
ide/public/numkit_ide.wasm

# ── Electron desktop ──────────────────────────────────
ide/desktop/dist/
ide/desktop/release/
ide/desktop/release.zip

# ── Tool / editor / OS state ──────────────────────────
.claude/
# Local emsdk env helper (machine-specific paths) + repl/test scratch output
.claude_*.sh
data.csv
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
/scratch/
*.diff
*.patch
*.orig
*diff*.txt
stash_*.txt

# ── Python (parity harness etc.) ──────────────────────
__pycache__/
*.pyc

# ── Temporary MATLAB / Octave probe scripts ───────────
# Throwaway .m files used to probe reference output during dev
# (probe_*.m and any scratch-named .m at repo root). Real .m fixtures
# live under examples/ and tools/parity/specs/.
/probe_*.m
/scratch*.m
# Per-cycle scratch probe directory (main worker dumps .m files
# here while iterating on parity refs).
tools/probe_tmp/

# ── Generated example mirror ──────────────────────────
# ide/public/examples/ is regenerated from examples/ on every
# `npm run dev` / `npm run build` (predev / prebuild → generate-
# manifest.js). Single source of truth: examples/.
ide/public/examples/

# ── Local deploy output ───────────────────────────────
# web-build.{bat,sh} build the IDE static site into deploy/ for local preview
# or manual upload. GitHub Pages is NOT served from this repo (the IDE repo
# owns deploys), so this output is never committed. doxygen/ now holds only the
# Doxygen source (doxygen_mainpage.dox) and is no longer a deploy target.
deploy/

# SIMD A/B run output (regenerated by benchmarks/simd/bench_simd.sh)
benchmarks/simd/*.json

# npm package build products (refresh via scripts/refresh-dist.js)
packages/numkit/dist/
packages/numkit/*.tgz

# Corpus-gate run artifacts (examples/IO/*.m scripts write these on every run)
examples/IO/*.mat
examples/IO/*.wav
examples/IO/*.png
examples/IO/*.csv
examples/IO/*.txt
examples/IO/*.bin
examples/IO/*.log

# Stray run artifacts in the repo root (renders/audio/probe outputs)
/*.png
/*.wav
/*.mat
packages/numkit/corpus_*.log
